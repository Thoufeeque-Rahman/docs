{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Festie",
  "description": "Documentation for setting up and running festivals with Festie.",
  "colors": {
    "primary": "#ff4e47",
    "light": "#f7ca59",
    "dark": "#2c75bb"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://docs.festie.app"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://admin.festie.app"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Start",
        "icon": "play",
